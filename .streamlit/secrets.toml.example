# Copy to secrets.toml and fill in real values:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Never commit secrets.toml.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
expose_tokens = ["access"]
# Request Drive read access so admins can sync photos from a configured folder.
client_kwargs = { scope = "openid email profile https://www.googleapis.com/auth/drive.readonly", prompt = "consent select_account" }

[prebidding]
admin_emails = ["you@yourdomain.com"]
allow_demo_login = false
# Folder ID or full URL: https://drive.google.com/drive/folders/<FOLDER_ID>
drive_folder_id = ""
